# mcbot 配置示例
# 复制此文件为 .env 并修改配置

# 服务器配置
MCBOT_HOST=your-server.com
MCBOT_PORT=25565
MCBOT_USERNAME=YourUsername

# 认证配置
MCBOT_AUTH=offline

# 密码二选一：
#   1) 明文（优先级最高，适合临时调试）
MCBOT_PASSWORD=
#   2) 加密：运行 node setup-security.mjs 生成 password.enc + 下面这个密钥
#      密钥必须是 32 字节（64 位 hex）
MCBOT_PASSWORD_KEY=

# UI 模式 (cli | tui)
MCBOT_UI=cli
