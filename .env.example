# mcbot 配置示例
# 复制此文件为 .env 并修改配置

# 服务器配置
MCBOT_HOST=your-server.com
MCBOT_PORT=25565
MCBOT_USERNAME=YourUsername

# 认证配置
MCBOT_AUTH=offline
MCBOT_PASSWORD=YourPassword

# 安全密钥 (必须与 password.enc 对应)
# 可以通过以下命令生成新的随机密钥:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# UI 模式 (cli | tui)
MCBOT_UI=cli
