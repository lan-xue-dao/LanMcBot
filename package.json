{
  "name": "mcbot",
  "version": "1.1.0",
  "description": "Minecraft mineflayer bot with 3D control panel, HTTP API and MCP server",
  "license": "ISC",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "start": "node index.js",
    "mcp": "node mcp-server.mjs",
    "mcp:sse": "node mcp-server.mjs --transport=sse",
    "mcp:stdio": "node mcp-server.mjs --transport=stdio",
    "verify": "node --check index.js && node --check lib/**/*.mjs",
    "lint": "eslint . --ext .mjs",
    "test": "mocha tests/**/*.test.mjs",
    "test:watch": "mocha tests/**/*.test.mjs --watch",
    "test:coverage": "nyc npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "ws": "^8.21.2"
  }
}
