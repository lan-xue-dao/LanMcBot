{
  "name": "mcbot",
  "version": "1.1.0",
  "description": "Minecraft mineflayer bot with 3D control panel, HTTP API and MCP server",
  "license": "ISC",
  "type": "commonjs",
  "main": "index.js",
  "bin": {
    "lanmcbot": "dist/lanmcbot.cjs"
  },
  "pkg": {
    "assets": ["lib/data/**/*"],
    "targets": ["node24-win-x64"]
  },
  "types": "index.d.ts",
  "scripts": {
    "start": "node index.js",
    "build:bundle": "esbuild index.js --bundle --platform=node --format=cjs --packages=external --outfile=dist/lanmcbot.cjs --log-level=warning",
    "build:exe": "npm run build:bundle && pkg dist/lanmcbot.cjs --config package.json --output dist/lanmcbot.exe --compress GZip --no-bytecode --public",
    "mcp": "node mcp-server.mjs",
    "mcp:sse": "node mcp-server.mjs --transport=sse",
    "mcp:stdio": "node mcp-server.mjs --transport=stdio",
    "verify": "node --check index.js && node --check lib/**/*.mjs",
    "lint": "eslint . --ext .mjs",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "test:coverage": "nyc npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mineflayer": "^4.37.1",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.24.0",
    "chai": "^5.3.3",
    "mocha": "^10.8.2"
  }
}
